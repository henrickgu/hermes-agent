  const familyIds = new Set(lineageAliases(storedSessionId, sessions));
  const lastReadAt = Date.now();
  const nextReadMap = { ...$lastReadAtBySessionId.get() };
  for (const id of familyIds) {
    nextReadMap[id] = lastReadAt;
